{
    "keyboard.dispatch": "keyCode",
    "workbench.startupEditor": "none",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontLigatures": true,
    "editor.fontFamily": "'DroidSansM Nerd Font', 'Droid Sans Mono', monospace",
    "window.zoomLevel": 0.8,
    "editor.fontSize": 16,
    // Vim Extension Configuration
    "vim.leader": ";",
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.incsearch": true,
    "vim.smartcase": true,
    "vim.timeout": 500,
    "vim.showmodename": true,
    "vim.highlightedyank.enable": true,
    "vim.highlightedyank.duration": 200,
    // Vim Normal Mode Mappings
    "vim.normalModeKeyBindingsNonRecursive": [
        // Yank to end of line
        {
            "before": [
                "Y"
            ],
            "after": [
                "y",
                "$"
            ]
        },
        // Redo with U
        {
            "before": [
                "U"
            ],
            "after": [
                "<C-r>"
            ]
        },
        // Leader mappings - File Explorer & Windows
        {
            "before": [
                "<leader>",
                "1"
            ],
            "commands": [
                "workbench.view.explorer"
            ]
        },
        {
            "before": [
                "<leader>",
                "2"
            ],
            "commands": [
                "workbench.view.extension.bookmarks"
            ]
        },
        {
            "before": [
                "<leader>",
                "3"
            ],
            "commands": [
                "workbench.view.extension.todo-tree-view"
            ]
        },
        {
            "before": [
                "<leader>",
                "4"
            ],
            "commands": [
                "workbench.actions.view.problems"
            ]
        },
        {
            "before": [
                "<leader>",
                "5"
            ],
            "commands": [
                "workbench.view.scm"
            ]
        },
        {
            "before": [
                "<leader>",
                "6"
            ],
            "commands": [
                "workbench.view.testing"
            ]
        },
        {
            "before": [
                "<leader>",
                "7"
            ],
            "commands": [
                "outline.focus"
            ]
        },
        {
            "before": [
                "<leader>",
                "8"
            ],
            "commands": [
                "workbench.action.toggleZenMode"
            ]
        },
        // Top row
        {
            "before": [
                "<leader>",
                "q"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<leader>",
                "Q"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<leader>",
                "w"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "<leader>",
                "W"
            ],
            "commands": [
                ":w"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "E"
            ],
            "commands": [
                "workbench.action.showAllEditorsByMostRecentlyUsed"
            ]
        },
        {
            "before": [
                "<leader>",
                "r"
            ],
            "commands": [
                "workbench.action.debug.run"
            ]
        },
        {
            "before": [
                "<leader>",
                "R"
            ],
            "commands": [
                "workbench.action.showAllEditorsByMostRecentlyUsed"
            ]
        },
        {
            "before": [
                "<leader>",
                "t"
            ],
            "commands": [
                "workbench.action.terminal.toggleTerminal"
            ]
        },
        {
            "before": [
                "<leader>",
                "T"
            ],
            "commands": [
                "workbench.action.terminal.focus"
            ]
        },
        {
            "before": [
                "<leader>",
                "u"
            ],
            "after": [
                "<C-u>"
            ]
        },
        {
            "before": [
                "<leader>",
                "i"
            ],
            "commands": [
                "bookmarks.toggle"
            ]
        },
        {
            "before": [
                "<leader>",
                "o"
            ],
            "commands": [
                "workbench.action.files.openFile"
            ]
        },
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "workbench.action.navigateBack"
            ]
        },
        {
            "before": [
                "<leader>",
                "P"
            ],
            "commands": [
                "workbench.action.toggleZenMode"
            ]
        },
        // Diagnostic navigation
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.next"
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prev"
            ]
        },
        // Middle row
        {
            "before": [
                "<leader>",
                "<Esc>"
            ],
            "commands": [
                "workbench.action.closePanel",
                "workbench.action.closeSidebar"
            ]
        },
        {
            "before": [
                "<leader>",
                "a"
            ],
            "commands": [
                "workbench.action.showCommands"
            ]
        },
        {
            "before": [
                "<leader>",
                "A"
            ],
            "after": [
                "g",
                "g",
                "V",
                "G"
            ]
        },
        {
            "before": [
                "<leader>",
                "s"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "r"
            ],
            "commands": [
                "workbench.action.openRecent"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "after": [
                "<C-d>"
            ]
        },
        {
            "before": [
                "<leader>",
                "d",
                "d"
            ],
            "commands": [
                "workbench.action.files.newUntitledFile"
            ]
        },
        {
            "before": [
                "<leader>",
                "D"
            ],
            "commands": [
                "git.openChange"
            ]
        },
        {
            "before": [
                "<leader>",
                "f",
                "f"
            ],
            "commands": [
                "workbench.action.quickOpen"
            ]
        },
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "F"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "<leader>",
                "g"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "<leader>",
                "h"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        {
            "before": [
                "<leader>",
                "H"
            ],
            "commands": [
                "workbench.action.splitEditorDown"
            ]
        },
        {
            "before": [
                "<leader>",
                "j"
            ],
            "commands": [
                "bookmarks.jumpToNext"
            ]
        },
        {
            "before": [
                "<leader>",
                "k"
            ],
            "commands": [
                "bookmarks.jumpToPrevious"
            ]
        },
        {
            "before": [
                "<leader>",
                "l"
            ],
            "commands": [
                "workbench.action.navigateToLastEditLocation"
            ]
        },
        {
            "before": [
                "<leader>",
                ";"
            ],
            "commands": [
                "workbench.action.navigateToLastEditLocation"
            ]
        },
        // Bottom row
        {
            "before": [
                "<leader>",
                "z"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "<leader>",
                "x"
            ],
            "commands": [
                "workbench.action.closeAllEditors"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "c"
            ],
            "commands": [
                "chatgpt.openSidebar"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "n"
            ],
            "commands": [
                "chatgpt.newChat"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "a"
            ],
            "commands": [
                "chatgpt.addToThread"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "f"
            ],
            "commands": [
                "chatgpt.addFileToThread"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "p"
            ],
            "commands": [
                "chatgpt.newCodexPanel"
            ]
        },
        {
            "before": [
                "<leader>",
                "v"
            ],
            "after": [
                "v",
                "i",
                "W"
            ]
        },
        {
            "before": [
                "<leader>",
                "V"
            ],
            "commands": [
                "workbench.action.splitEditorRight"
            ]
        },
        {
            "before": [
                "<leader>",
                "b"
            ],
            "after": [
                "%"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "workbench.action.nextEditor"
            ]
        },
        {
            "before": [
                "<leader>",
                "m"
            ],
            "commands": [
                "workbench.action.gotoSymbol"
            ]
        },
        {
            "before": [
                "<leader>",
                "M"
            ],
            "commands": [
                "workbench.action.showAllSymbols"
            ]
        },
        {
            "before": [
                "<leader>",
                "."
            ],
            "commands": [
                "editor.debug.action.toggleBreakpoint"
            ]
        },
        {
            "before": [
                "<leader>",
                "/"
            ],
            "commands": [
                ":noh"
            ]
        },
        // G actions (goto)
        {
            "before": [
                "g",
                "e"
            ],
            "commands": [
                "workbench.action.showCommands"
            ]
        },
        {
            "before": [
                "g",
                "u"
            ],
            "commands": [
                "references-view.findReferences"
            ]
        },
        {
            "before": [
                "g",
                "i"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "h"
            ],
            "commands": [
                "workbench.action.openLocalHistory"
            ]
        }
    ],
    // Vim Visual Mode Mappings
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<leader>",
                "h"
            ],
            "commands": [
                "editor.action.commentLine"
            ]
        },
        {
            "before": [
                "<leader>",
                "f"
            ],
            "commands": [
                "workbench.action.findInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "i"
            ],
            "commands": [
                "inlineChat.start"
            ]
        }
    ],
    // Editor improvements
    "editor.lineNumbers": "relative",
    "editor.cursorBlinking": "solid",
    "editor.formatOnSave": true,
    "files.autoSave": "afterDelay",
    "workbench.editor.enablePreview": false,
    "breadcrumbs.enabled": true,
    "editor.stickyScroll.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "continue.enableTabAutocomplete": false,
    "editor.codeActionsOnSave": {},
    // Cai theme overrides
    "workbench.colorCustomizations": {
        "editor.background": "#09111a",
        "editor.foreground": "#d9e6f2",
        "sideBar.background": "#09111a",
        "sideBar.foreground": "#d9e6f2",
        "activityBar.background": "#09111a",
        "titleBar.activeBackground": "#09111a",
        "titleBar.activeForeground": "#d9e6f2",
        "statusBar.background": "#0f1923",
        "statusBar.foreground": "#d9e6f2",
        "tab.activeBackground": "#1a2a3a",
        "tab.inactiveBackground": "#09111a",
        "tab.activeForeground": "#d9e6f2",
        "tab.inactiveForeground": "#506882",
        "editorGroupHeader.tabsBackground": "#09111a",
        "panel.background": "#09111a",
        "panel.border": "#1e3040",
        "terminal.background": "#09111a",
        "terminal.foreground": "#d9e6f2",
        "terminal.ansiBlack": "#000000",
        "terminal.ansiRed": "#ca274d",
        "terminal.ansiGreen": "#4dca27",
        "terminal.ansiYellow": "#caa427",
        "terminal.ansiBlue": "#274dca",
        "terminal.ansiMagenta": "#a427ca",
        "terminal.ansiCyan": "#27caa4",
        "terminal.ansiWhite": "#808080",
        "terminal.ansiBrightBlack": "#808080",
        "terminal.ansiBrightRed": "#e98da3",
        "terminal.ansiBrightGreen": "#a3e98d",
        "terminal.ansiBrightYellow": "#e9d48d",
        "terminal.ansiBrightBlue": "#8da3e9",
        "terminal.ansiBrightMagenta": "#d48de9",
        "terminal.ansiBrightCyan": "#8de9d4",
        "terminal.ansiBrightWhite": "#ffffff",
        "editorLineNumber.foreground": "#2a3a4a",
        "editorLineNumber.activeForeground": "#e9d48d",
        "editor.lineHighlightBackground": "#0f1923",
        "editor.selectionBackground": "#1e3348",
        "editorCursor.foreground": "#d9e6f2",
        "list.activeSelectionBackground": "#1a2a3a",
        "list.hoverBackground": "#0f1923",
        "input.background": "#0f1923",
        "input.border": "#1e3040",
        "dropdown.background": "#0f1923",
        "dropdown.border": "#1e3040",
        "focusBorder": "#274dca",
        "editorWidget.background": "#0f1923",
        "editorWidget.border": "#1e3040",
        "peekViewEditor.background": "#0f1923",
        "peekViewResult.background": "#09111a"
    },
    "terminal.integrated.cursorStyle": "line",
    "http.systemCertificatesNode": true,
    "workbench.iconTheme": "symbols",
    "workbench.activityBar.location": "hidden",
    "workbench.colorTheme": "Dark Modern",
    "diffEditor.renderSideBySide": false,
    "claudeCode.preferredLocation": "sidebar",
    "explorer.confirmPasteNative": false,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editor.showTabs": "none",
    "chat.viewSessions.orientation": "stacked"
}
